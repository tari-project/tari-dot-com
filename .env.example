# Public environment variables consumed by Next.js (NEXT_PUBLIC_* is embedded at build time).
# Copy this file to .env.local and fill in real values for local development.
# Production/staging values are injected via wrangler / CI.

# --- API endpoints ----------------------------------------------------------

# Base URL for the Tari RWA / miner API.
# Fallback in code: https://rwa.y.at
NEXT_PUBLIC_RWA_API=https://rwa.y.at

# --- Web3 / WalletConnect ---------------------------------------------------

# WalletConnect / Reown AppKit project id.
# Obtain at https://cloud.walletconnect.com/
# Fallback in code: c523cd3d3e0246530115c1dc2c016852 (public test id — replace for prod).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=c523cd3d3e0246530115c1dc2c016852

# Legacy alias for WALLETCONNECT_PROJECT_ID. Kept for backwards compatibility;
# WALLETCONNECT_PROJECT_ID takes precedence when both are set. Prefer the new name.
NEXT_PUBLIC_PROJECT_ID=

# --- Captcha ----------------------------------------------------------------

# Cloudflare Turnstile site key used by the signup / download forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Analytics (GTM + GA) ---------------------------------------------------
# These are currently hardcoded in src/ui-shared/layouts/Layout/Layout.tsx.
# Migration to env-driven values is deferred to avoid conflicting with an
# in-flight edit of that file by another agent. Once that lands, wire these in.

# Google Tag Manager container id (e.g. GTM-PSQML865)
NEXT_PUBLIC_GTM_ID=GTM-PSQML865

# Primary Google Analytics measurement id (via @next/third-parties)
NEXT_PUBLIC_GA_ID_PRIMARY=G-K7EWCBLYHN

# Secondary Google Analytics measurement id (raw gtag.js)
NEXT_PUBLIC_GA_ID_SECONDARY=G-MG7C9LNNYV

# --- Cloudflare Stream ------------------------------------------------------
# Cloudflare Stream customer subdomain (without the .cloudflarestream.com suffix).
# Currently referenced literally in several components and the preload tags on
# the home page. Not yet wired through env — leaving here for future extraction.
NEXT_PUBLIC_CF_STREAM_CUSTOMER=customer-o6ocjyfui1ltpm5h
