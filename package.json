{
    "name": "tari-dot-com-2025",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs",
        "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "pages:build": "opennextjs-cloudflare build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
        "prebuild-updates": "node scripts/generate-updates-data.js",
        "prebuild-lessons": "node scripts/generate-lessons-data.js",
        "prebuild-all": "npm run prebuild-updates && npm run prebuild-lessons"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.5",
        "@next/third-parties": "^16.2.4",
        "@number-flow/react": "^0.5.10",
        "@opennextjs/cloudflare": "^1.19.4",
        "@reown/appkit": "^1.7.8",
        "@reown/appkit-adapter-wagmi": "^1.7.8",
        "@reown/appkit-wallet-button": "^1.7.7",
        "@tanstack/react-query": "^5.67.3",
        "@uniswap/sdk-core": "^7.7.2",
        "@uniswap/v3-core": "^1.0.1",
        "@uniswap/v3-periphery": "^1.4.4",
        "@uniswap/v3-sdk": "^3.25.2",
        "ethers": "^6.14.3",
        "gray-matter": "^4.0.3",
        "hls.js": "^1.6.2",
        "motion": "^12.5.0",
        "next": "^16.2.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-icons": "^5.5.0",
        "react-markdown": "^10.1.0",
        "react-turnstile": "^1.1.4",
        "react-use": "^17.6.0",
        "styled-components": "^6.1.19",
        "uuid": "^11.1.0",
        "viem": "^2.30.6",
        "wagmi": "^3.0.0",
        "zustand": "^5.0.5"
    },
    "overrides": {
        "@wagmi/connectors": "^8.0.0",
        "@wagmi/core": "^3.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@types/node": "^22.13.10",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/styled-components": "^5.1.34",
        "esbuild": "^0.28.0",
        "eslint": "^9",
        "eslint-config-next": "^16.2.4",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.6.0",
        "typescript": "^5",
        "wrangler": "^4.84.1"
    }
}
