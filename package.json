{
    "name": "tari-dot-com-2025",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@11.9.0",
    "scripts": {
        "dev": "next dev --turbopack",
        "build": "next build",
        "start": "next start",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,mts,mjs}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,mts,mjs}\"",
        "build:worker": "opennextjs-cloudflare build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
        "cf-typegen": "wrangler types --env-file .env.typegen --env-interface CloudflareEnv cloudflare-env.d.ts",
        "prebuild-updates": "node scripts/generate-updates-data.js",
        "prebuild-lessons": "node scripts/generate-lessons-data.js",
        "prebuild-posts": "node scripts/generate-posts-data.js",
        "prebuild-all": "pnpm run prebuild-updates && pnpm run prebuild-lessons && pnpm run prebuild-posts"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.20",
        "@next/third-parties": "^16.3.4",
        "@number-flow/react": "^0.6.2",
        "@opennextjs/cloudflare": "^1.20.6",
        "@tanstack/react-query": "^5.102.8",
        "@uniswap/sdk-core": "^7.19.2",
        "@uniswap/v3-core": "^1.0.1",
        "@uniswap/v3-periphery": "^1.4.4",
        "@uniswap/v3-sdk": "^3.31.3",
        "@walletconnect/ethereum-provider": "^2.24.0",
        "ethers": "^6.17.0",
        "gray-matter": "^4.0.3",
        "hls.js": "^1.7.2",
        "jsbi": "^3.2.5",
        "motion": "^12.43.0",
        "next": "16.2.10",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-markdown": "^10.1.0",
        "react-turnstile": "^1.1.5",
        "react-use": "^17.6.1",
        "styled-components": "^6.5.3",
        "uuid": "^11.1.1",
        "viem": "^2.56.5",
        "wagmi": "^3.7.7",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.5.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/styled-components": "^5.1.36",
        "@vitejs/plugin-react": "^6.1.1",
        "esbuild": "0.25.4",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.2.10",
        "jsdom": "^30.0.1",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3",
        "vitest": "^5.0.0",
        "wrangler": "^4.132.0"
    }
}
